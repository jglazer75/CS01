{% if site.data.navigation %}
  <div class="navigation-wrapper">
    <nav id="primary-nav" class="site-nav animated drop">
      <ul>
        {% for link in site.data.navigation %}
          <li><a href={{ link.url }}>{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
{% endif %}